# gstack superagent — copy to the repo root: `cp superagent/.env.example .env` (Bun loads it automatically).
# Only ANTHROPIC_API_KEY and OWNER_* are required to try it in the terminal:
#   bun run superagent:console
# Check everything with:
#   bun run superagent:check

# ─── Brain ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# SUPERAGENT_MODEL=claude-opus-5-5
# Thinking depth for chat replies / background work: low | medium | high | xhigh | max
# SUPERAGENT_EFFORT=medium
# SUPERAGENT_BACKGROUND_EFFORT=high

# ─── You ─────────────────────────────────────────────────────────────
AGENT_NAME=Superagent
OWNER_NAME=Ada
OWNER_TIMEZONE=Europe/London
# Your WhatsApp number(s), digits with country code. ONLY these numbers can command the agent.
OWNER_PHONES=447700900123
# Teammates who can use the agent without your email/calendar/files (optional)
# MEMBER_PHONES=447700900456,15551234567

# ─── Server ──────────────────────────────────────────────────────────
PORT=8787
# The public https URL that reaches this server (WhatsApp webhooks, Google sign-in, file links)
PUBLIC_BASE_URL=https://agent.example.com
# Long random string. Signs you into the web chat: https://agent.example.com/chat?token=...
ADMIN_TOKEN=change-me-to-a-long-random-string
# SUPERAGENT_DATA_DIR=~/.gstack/superagent

# ─── WhatsApp Business Cloud API (Meta) ──────────────────────────────
# See superagent/README.md → "Connect WhatsApp".
# WHATSAPP_TOKEN=EAAG...                 # permanent System User token
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_APP_SECRET=abc123...          # App settings → Basic → App secret
# WHATSAPP_VERIFY_TOKEN=any-string-you-choose
# WHATSAPP_GRAPH_VERSION=v24.0
# Approved utility template with ONE body variable, used to reach you after 24h of silence:
# WHATSAPP_TEMPLATE_NAME=agent_update
# WHATSAPP_TEMPLATE_LANGUAGE=en

# ─── Discord (no business verification or public URL needed) ─────────
# See superagent/README.md → "Or: Discord". The log prints an invite link and a pairing code.
# DISCORD_BOT_TOKEN=
# Skip pairing by naming your Discord user id (Settings → Advanced → Developer Mode, then right-click yourself → Copy User ID)
# DISCORD_OWNER_ID=
# Where reminders and briefs go when you haven't written recently: whatsapp | discord | web
# PRIMARY_CHANNEL=discord

# ─── Behaviour ───────────────────────────────────────────────────────
# Proactive messages wait until morning (replies to you are never delayed)
QUIET_HOURS=22:30-07:00
# Hard stop on spend per day (USD); raise for one day with /budget 30
DAILY_BUDGET_USD=15
# Wait this long for more bubbles before answering (ms)
# DEBOUNCE_MS=1500
# Summarize the conversation once it grows past this many tokens
# COMPACT_AT_TOKENS=60000
# MAX_SUBAGENTS=12

# ─── Google: Gmail, Calendar, Drive ──────────────────────────────────
# OAuth client (type "Web application"), redirect URI: <PUBLIC_BASE_URL>/oauth/google/callback
# Then send /connect google to the agent.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# ─── Notion ──────────────────────────────────────────────────────────
# Internal integration token; share the pages/databases it may use with it.
# NOTION_TOKEN=ntn_...
# Your capture inbox database ("The Hub"): the 32-character id from its URL
# NOTION_HUB_DATABASE_ID=0123456789abcdef0123456789abcdef

# ─── Voice notes, voice replies, image generation ────────────────────
# One OpenAI key turns on all three. Any OpenAI-compatible endpoint works per feature.
# OPENAI_API_KEY=sk-...
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=...
# STT_MODEL=whisper-large-v3
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# IMAGE_MODEL=gpt-image-1

# ─── Phone calls (Twilio) ────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15550009999

# ─── Extra connectors (remote MCP servers, run by Anthropic's MCP connector) ──
# Tool calls on these run without the approval prompt, so prefer read-only servers.
# MCP_SERVERS=[{"name":"linear","url":"https://mcp.linear.app/mcp","authorization_token":"..."}]

# ─── Browser ─────────────────────────────────────────────────────────
# Use a system Chromium for PDF rendering instead of Playwright's download
# CHROMIUM_PATH=/usr/bin/chromium
